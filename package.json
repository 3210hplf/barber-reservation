{
  "name": "barber-reservation",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run db:migrate && bun run build:client && bun server/src/index.ts",
    "build": "bun run build:client",
    "build:client": "bun ./client/build.mjs",
    "start": "bun server/src/index.ts",
    "db:migrate": "bun server/src/migrate.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@tailwindcss/cli": "4.1.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "typescript": "5.6.3"
  }
}
